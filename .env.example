# 1) Primero usa true. Revisa resultado_carga.csv.
# 2) Cuando todo esté correcto, cambia a false para ejecutar la carga real.
DRY_RUN=true

CSV_PATH=./Data para COMPRAS Y PROVEEDORES(REG(1).csv
